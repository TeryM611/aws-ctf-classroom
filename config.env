# Central configuration -- every script sources this file.
# Any value can also be overridden from the environment for one run, e.g.
#   REGION=us-west-2 ./kali_fleet/provision_students.sh

# Prefix for every AWS resource name and tag this kit creates. Change it if you
# run more than one class (or section) in the same AWS account, so teardown of
# one never touches the other.
PROJECT="${PROJECT:-ctf-lab}"

# AWS region. Defaults to your AWS CLI profile's region, else us-east-1.
REGION="${REGION:-$(aws configure get region 2>/dev/null || echo us-east-1)}"

# ---------------------------------------------------------------- target ----
TARGET_INSTANCE_TYPE="${TARGET_INSTANCE_TYPE:-t3.micro}"
# Every port published in target/deploy/docker-compose.yml. The security
# group only ever opens these, and only to IPs listed in target/roster.csv.
APP_PORTS="${APP_PORTS:-5000}"

# ------------------------------------------------------------ kali fleet ----
KALI_INSTANCE_TYPE="${KALI_INSTANCE_TYPE:-t3.small}"   # Burp's JVM wants >1GB RAM
# Leave empty to auto-select the newest official Kali AMI in $REGION.
KALI_AMI="${KALI_AMI:-}"
# sshd is moved off port 22 -- not the security control (pubkey-only auth is),
# just far fewer automated scanners knocking.
SSH_PORT="${SSH_PORT:-48022}"

# Tools installed on every student VM at first boot. The base Kali AMI ships
# with almost nothing -- not even `file`, `strings` or `gdb`. Trim this to what
# your course actually uses: ghidra alone is ~800MB and slows first boot.
KALI_PACKAGES="${KALI_PACKAGES:-gobuster nmap burpsuite file binutils gdb libimage-exiftool-perl binwalk hashcat john python3-pip python3-sympy ghidra}"
PIP_PACKAGES="${PIP_PACKAGES:-pwntools}"

# --------------------------------------------------------- daily schedule ----
# Kali VMs start at START_HOUR and stop at STOP_HOUR every day (24h clock).
TIMEZONE="${TIMEZONE:-America/New_York}"
START_HOUR="${START_HOUR:-9}"
STOP_HOUR="${STOP_HOUR:-0}"
